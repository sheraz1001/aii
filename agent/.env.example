# LiveKit Cloud project (Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech-to-text and voice
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional: default ElevenLabs voice (pick one that speaks Arabic and English)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# The brain: anthropic or openai
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# aii web app (Laravel). Leave AII_API_URL empty to use demo_business.json
AII_API_URL=https://app.aii.ae
AII_AGENT_TOKEN=

AGENT_NAME=aii-secretary
